Feature: User Authentication # features/login.feature:1

  Background:   # features/login.feature:3

  Scenario: Successful login with valid credentials               # features/login.feature:6
    Given the user navigates to the OrangeHRM login page          # features/steps/login_steps.py:6
    When the user enters username "Admin" and password "admin123" # features/steps/login_steps.py:21
    And the user clicks the login button                          # features/steps/login_steps.py:27
    Then the user should be redirected to the dashboard page      # features/steps/login_steps.py:32

  Scenario: Unsuccessful login with invalid password                # features/login.feature:11
    Given the user navigates to the OrangeHRM login page            # features/steps/login_steps.py:6
    When the user enters username "Admin" and password "invalid123" # features/steps/login_steps.py:21
    And the user clicks the login button                            # features/steps/login_steps.py:27
    Then an error message "Invalid credentials" should be displayed # features/steps/login_steps.py:38

Feature: Employee Management - PIM Module # features/pim_employee.feature:1

  Background:   # features/pim_employee.feature:3

  Scenario Outline: Add multiple new employees -- @1.1              # features/pim_employee.feature:15
    Given the user is logged in as "Admin" with password "admin123" # features/steps/login_steps.py:12
    And the user navigates to the PIM module                        # features/steps/pim_steps.py:5
    When the user clicks the Add Employee button                    # features/steps/pim_steps.py:11
    And the user enters first name "John" and last name "Smith"     # features/steps/pim_steps.py:16
    And the user clicks the save button                             # features/steps/pim_steps.py:22
    Then the employee "John Smith" should be created successfully   # features/steps/pim_steps.py:27

  Scenario Outline: Add multiple new employees -- @1.2              # features/pim_employee.feature:16
    Given the user is logged in as "Admin" with password "admin123" # features/steps/login_steps.py:12
    And the user navigates to the PIM module                        # features/steps/pim_steps.py:5
    When the user clicks the Add Employee button                    # features/steps/pim_steps.py:11
    And the user enters first name "Jane" and last name "Doe"       # features/steps/pim_steps.py:16
    And the user clicks the save button                             # features/steps/pim_steps.py:22
    Then the employee "Jane Doe" should be created successfully     # features/steps/pim_steps.py:27

  Scenario Outline: Add multiple new employees -- @1.3                 # features/pim_employee.feature:17
    Given the user is logged in as "Admin" with password "admin123"    # features/steps/login_steps.py:12
    And the user navigates to the PIM module                           # features/steps/pim_steps.py:5
    When the user clicks the Add Employee button                       # features/steps/pim_steps.py:11
    And the user enters first name "Robert" and last name "Williams"   # features/steps/pim_steps.py:16
    And the user clicks the save button                                # features/steps/pim_steps.py:22
    Then the employee "Robert Williams" should be created successfully # features/steps/pim_steps.py:27

