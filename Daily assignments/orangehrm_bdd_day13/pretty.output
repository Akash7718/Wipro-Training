Feature: User Authentication # features/login.feature:1

  Background:   # features/login.feature:3

  Scenario: Successful login with valid credentials               # features/login.feature:6
    Given the user navigates to the OrangeHRM login page          # features/steps/login_steps.py:7
    When the user enters username "Admin" and password "admin123" # features/steps/login_steps.py:26
    And the user clicks the login button                          # features/steps/login_steps.py:33
    Then the current URL should contain "dashboard"               # features/steps/login_steps.py:38

  Scenario: Unsuccessful login with invalid password                # features/login.feature:11
